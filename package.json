{
  "name": "liquid-glass-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "Liquid Glass material system (Tier A WebGL2 + Tier B CSS frost) in an Electron + Vite accounting demo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:apk": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.10.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
